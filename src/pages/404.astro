---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
---

<Base title="Not found">
  <section class="nf wrap">
    <p class="label">404</p>
    <h1>This page has drifted away.</h1>
    <p><a href={url('/walks/')}>See the walks</a> or <a href={url('/')}>go home</a>.</p>
  </section>
</Base>

<style>
  .nf { padding-block: var(--s12); }
  h1 {
    margin: var(--s2) 0 var(--s3);
    font-family: var(--script);
    font-weight: 400;
    font-size: clamp(2.75rem, 2.2rem + 2.5vw, 4rem);
    line-height: 1.2;
  }
  p { margin: 0; }
</style>
