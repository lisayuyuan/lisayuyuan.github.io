---
import Base from '../../layouts/Base.astro';
import PhotoStream from '../../components/PhotoStream.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getYears } from '../../lib/sets';
import { settings } from '../../lib/site';

const years = await getYears();
---

<Base title="Walks" section="walks" description={`Photographs by ${settings.name}, newest first.`}>
  <div class="wrap">
    <header class="walks-head">
      <h1>Walks</h1>
      {
        years.length > 1 && (
          <nav class="jump" aria-label="Jump to year">
            <ul>
              {years.map((y) => (
                <li>
                  <a href={`#y${y.year}`}>{y.year}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </header>

    {years.length === 0 && <p class="empty">New photographs are on their way.</p>}

    <PhotoStream years={years} />

    {
      years.length > 0 && (
        <p class="to-top">
          <a href="#main">Back to top <span aria-hidden="true">↑</span></a>
        </p>
      )
    }
  </div>

  <Lightbox />
</Base>

<style>
  .walks-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s2) var(--s4);
    margin: var(--s4) 0 clamp(4rem, 12vh, 8rem);
  }

  h1 {
    font-family: var(--display);
    letter-spacing: 0.04em;
    font-weight: 400;
    font-size: clamp(3.25rem, 2.6rem + 3vw, 5rem);
    line-height: 1;
  }

  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .jump a {
    display: inline-block;
    padding-block: var(--s1);
    font-size: 1.0625rem;
    text-decoration: none;
    color: var(--muted);
  }
  .jump a:hover { color: var(--accent-deep); }

  .empty { color: var(--muted); }

  .to-top {
    margin: clamp(6rem, 18vh, 10rem) 0 0;
    text-align: center;
  }
  .to-top a {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
    padding-block: var(--s1);
  }
  .to-top a:hover { color: var(--accent-deep); }
</style>
