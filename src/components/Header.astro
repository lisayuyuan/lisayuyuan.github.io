---
import { settings, url } from '../lib/site';

interface Props {
  section?: 'home' | 'walks' | 'research' | 'about';
}
const { section } = Astro.props;
const links = [
  { href: url('/walks/'), label: 'Walks', key: 'walks' },
  { href: url('/research/'), label: 'Research', key: 'research' },
  { href: url('/about/'), label: 'About', key: 'about' },
] as const;
---

<header class="site-header wrap">
  <a class="name" href={url('/')} aria-current={section === 'home' ? 'page' : undefined}>{settings.name}</a>
  <nav aria-label="Main">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={section === l.key ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap; /* on narrow phones the nav drops below the name */
    align-items: baseline;
    justify-content: space-between;
    gap: 0 var(--s2);
    padding-block: var(--s4) var(--s3);
  }
  @media (min-width: 640px) {
    .site-header { padding-block: var(--s6) var(--s4); }
  }

  .name {
    font-family: var(--display);
    letter-spacing: 0.08em;
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1;
    text-decoration: none;
  }

  ul {
    display: flex;
    gap: var(--s2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) { ul { gap: var(--s4); } }

  nav a {
    position: relative;
    display: inline-block;
    padding-block: var(--s1);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
  }
  nav a:hover { color: var(--accent-deep); }
  nav a[aria-current='page'] { color: var(--text); }
  nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0; right: 0.16em; bottom: 2px;
    height: 1px;
    background: var(--accent);
  }
</style>
